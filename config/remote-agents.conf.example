# remote-agents configuration. Copy to ~/.config/remote-agents/config and edit.
# "key = value" lines; a whole line starting with # is a comment. After a change run
# `remote-agents install` (new or removed servers) or nothing at all (everything else is read
# again within 20 seconds).

# ---------------------------------------------------------------- where the servers live
#
# By default each server's supervisor is a LaunchAgent: no terminal needed, output in
# ~/Library/Logs/remote-agents/NAME.log.
#
# Set start_command to run the supervisors somewhere else, for example in tabs of a terminal app,
# so the sessions inherit that app's macOS permissions (screen recording, automation, local
# network) and you can watch the server's own screen. The command is run when a supervisor is
# missing. Each word of it is one argument; it is not run through a shell. {name} and {dir} are
# replaced as they are. {run} becomes the supervisor's command line, quoted for a shell, for
# terminals that take a command line to run:
#
# start_command = agtermctl session new --cwd {dir} --name {name} --workspace-name agents --create-workspace --no-select --command {run}
#
# A [server NAME] section can have its own start_command (for example another workspace).
#
# start_setup runs before it (for example to launch the terminal app after a reboot), and
# start_delay is how long after login the watchdog waits before it starts anything, which gives
# a terminal that restores its own tabs time to do so.
#
# start_setup = open -g -a agterm
# start_delay = 90

# ---------------------------------------------------------------- behaviour

# What "the network is up" means: this URL answers.
probe_url = https://api.anthropic.com/

# `remote-agents restart` and `stop` refuse while a session was active in the last min_idle seconds.
min_idle = 600

# A server that has been down for this long becomes an incident.
down_after = 300

# Folder for `remote-agents reattach` (a trusted folder that no server uses).
# reattach_dir = ~/agents-helper

# Path of the claude binary, when it is not ~/.local/bin/claude or on PATH.
# claude = /opt/homebrew/bin/claude

# Prefix of the LaunchAgent labels.
label_prefix = com.remote-agents

# ---------------------------------------------------------------- servers
#
# One section per Remote Control server: a folder and the flags for `claude remote-control`
# (see `claude remote-control --help`). The name is what the Claude app shows. The folder must be
# trusted by Claude Code: run `claude` in it once and accept. One server per folder.
# --no-create-session-in-dir is always dropped: with it every stop archives the open sessions.

[server projects]
dir = ~/projects
flags = --permission-mode default

# [server sandbox]
# dir = ~/sandbox
# flags = --chrome --permission-mode auto
#
# observe = yes   only watch this server and report; never start it. For a server that something
#                 else still runs, while you move it over.

# ---------------------------------------------------------------- Codex

[codex]
# Keep the Codex app-server daemon with remote control running and connected.
enabled = no
# command = /opt/homebrew/bin/codex
# Minutes of "not connected" (in seconds) before it becomes an incident.
alert_after = 1800

# ---------------------------------------------------------------- incidents and repair

[repair]
# What happens when the watchdog finds something it cannot heal:
#   1. a notification on this Mac;
#   2. notify_command, if set: any command, it gets the message as its last argument. Use it to
#      reach yourself when you are away (a webhook script, a messenger CLI). It is retried until
#      it succeeds.
#   3. agent = claude (needs dir, below): a Claude Code session on a cheap model, with Remote
#      Control on, so it appears in the Claude app. It diagnoses with read-only commands, may run
#      `remote-agents ensure`, and asks you there before anything else. agent = none: steps 1-2 only.
agent = none
model = haiku
permission_mode = default
# notify_command = ~/bin/notify-me
# Folder the repair session starts in. Required for agent = claude. Give it a folder of its own:
# an empty one, trusted by Claude Code (run `claude` in it once and accept), with no project
# settings, so that nothing but the short list of read-only commands runs without your approval.
# dir = ~/agents-repair
# An idle repair session is closed after this many seconds.
ttl = 7200
